// =========================================================
// STORAGE LAYER (with localStorage fallback to in-memory)
// =========================================================
let memoryStore = null; // fallback if localStorage unavailable
let storageWorks = true;

try {
  const testKey = '__test_' + Date.now();
  localStorage.setItem(testKey, '1');
  localStorage.removeItem(testKey);
} catch(e) {
  storageWorks = false;
  console.warn('localStorage indisponible — utilisation du stockage en mémoire (les données seront perdues au rechargement)');
}

function storageGet(key) {
  if (!storageWorks) return memoryStore?.[key] || null;
  try { return localStorage.getItem(key); } catch(e) { return null; }
}

function storageSet(key, value) {
  if (!storageWorks) {
    if (!memoryStore) memoryStore = {};
    memoryStore[key] = value;
    return true;
  }
  try { localStorage.setItem(key, value); return true; } catch(e) {
    toast('⚠ Sauvegarde locale échouée (quota dépassé ?)', 'error');
    return false;
  }
}

function loadData() {
  const raw = storageGet(STORAGE_KEY);
  if (!raw) return JSON.parse(JSON.stringify(DEFAULT_DATA));
  try {
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) throw new Error('Invalid stored data');
    return parsed;
  } catch(e) {
    console.error('Données corrompues, rechargement des données par défaut');
    return JSON.parse(JSON.stringify(DEFAULT_DATA));
  }
}

let saveTimer = null;
function persist() {
  clearTimeout(saveTimer);
  setSaveIndicator('saving');
  saveTimer = setTimeout(() => {
    const ok = storageSet(STORAGE_KEY, JSON.stringify(state.flagships));
    const meta = { lastSaved: new Date().toISOString(), version: 1 };
    storageSet(STORAGE_META_KEY, JSON.stringify(meta));
    setSaveIndicator(ok ? 'saved' : 'error');
  }, AUTO_SAVE_DEBOUNCE);
}

function setSaveIndicator(status) {
  const el = document.getElementById('save-indicator');
  if (!el) return;
  if (status === 'saving') { el.textContent = '⟳ Saving…'; el.className = 'save-indicator'; }
  else if (status === 'saved') {
    const now = new Date();
    el.textContent = `✓ Saved ${now.toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'})}`;
    el.className = 'save-indicator saved';
  } else if (status === 'error') { el.textContent = '⚠ Save failed'; el.className = 'save-indicator'; }
  else if (status === 'init') {
    const meta = storageGet(STORAGE_META_KEY);
    if (meta) {
      try {
        const m = JSON.parse(meta);
        const d = new Date(m.lastSaved);
        el.textContent = `✓ Saved ${d.toLocaleDateString('fr-FR')} ${d.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})}`;
        el.className = 'save-indicator saved';
      } catch(e) { el.textContent = '—'; }
    } else { el.textContent = '—'; }
  }
}

