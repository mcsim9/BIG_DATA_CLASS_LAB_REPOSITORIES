<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TOP 18 Flagships — AI Use Case Registry</title>
<style>
:root {
  --bg: #f5f3ee;
  --bg-card: #ffffff;
  --bg-elevated: #fbfaf7;
  --ink: #0d1b2a;
  --ink-soft: #3a4a5c;
  --ink-muted: #6b7a8c;
  --line: #e3ddd0;
  --line-strong: #c9c0ad;
  --accent: #8b1e3f;
  --accent-soft: #f4e8eb;
  --gold: #a07c2c;
  --gold-soft: #f5edd6;
  --success: #2d5a3d;
  --success-soft: #e3ede5;
  --warn: #8a5a00;
  --warn-soft: #f7ecd1;
  --shadow-sm: 0 1px 2px rgba(13,27,42,0.04), 0 0 0 1px rgba(13,27,42,0.04);
  --shadow-md: 0 4px 16px rgba(13,27,42,0.06), 0 0 0 1px rgba(13,27,42,0.05);
  --shadow-lg: 0 20px 60px rgba(13,27,42,0.12);
  --serif: Georgia, "Times New Roman", "Iowan Old Style", serif;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, "SF Mono", "Cascadia Mono", "Roboto Mono", Consolas, "Courier New", monospace;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: var(--sans);
  background: var(--bg);
  color: var(--ink);
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}
.topbar { background: var(--ink); color: #f5f3ee; padding: 14px 32px; display: flex; align-items: center; justify-content: space-between; border-bottom: 3px solid var(--accent); flex-wrap: wrap; gap: 12px; }
.brand { display: flex; align-items: center; gap: 14px; }
.brand-mark { width: 32px; height: 32px; background: linear-gradient(135deg, var(--accent) 0%, var(--gold) 100%); display: flex; align-items: center; justify-content: center; font-family: var(--serif); font-weight: 700; font-size: 18px; color: #fff; }
.brand-name { font-family: var(--serif); font-size: 18px; font-weight: 600; letter-spacing: 0.3px; }
.brand-sub { font-size: 11px; color: rgba(245,243,238,0.6); text-transform: uppercase; letter-spacing: 2px; margin-left: 6px; border-left: 1px solid rgba(245,243,238,0.2); padding-left: 14px; }
.topbar-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.topbar-btn { background: transparent; color: #f5f3ee; border: 1px solid rgba(245,243,238,0.2); padding: 7px 14px; font-family: inherit; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; transition: all 0.2s; }
.topbar-btn:hover { background: rgba(245,243,238,0.08); border-color: rgba(245,243,238,0.4); }
.mode-badge { font-size: 10px; padding: 5px 10px; border: 1px solid; font-family: var(--mono); letter-spacing: 1.2px; text-transform: uppercase; }
.mode-badge.read { background: rgba(245,243,238,0.05); color: #c9c0ad; border-color: rgba(245,243,238,0.2); }
.mode-badge.edit { background: var(--accent); color: #fff; border-color: var(--accent); }
.save-indicator { font-size: 10px; color: rgba(245,243,238,0.5); font-family: var(--mono); letter-spacing: 1px; }
.save-indicator.saved { color: #a8d5b2; }
.breadcrumb { background: var(--bg-elevated); padding: 12px 32px; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 10px; font-size: 11px; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 1.2px; }
.breadcrumb a { color: var(--ink-soft); text-decoration: none; cursor: pointer; transition: color 0.15s; }
.breadcrumb a:hover { color: var(--accent); }
.breadcrumb .sep { color: var(--line-strong); }
.breadcrumb .current { color: var(--ink); font-weight: 600; }
main { padding: 32px; max-width: 1400px; margin: 0 auto; }
.view { display: none; animation: fadeIn 0.3s ease; }
.view.active { display: block; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
.page-header { margin-bottom: 28px; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
.page-title { font-family: var(--serif); font-size: 38px; font-weight: 600; letter-spacing: -1px; line-height: 1.1; }
.page-title .accent { color: var(--accent); font-style: italic; }
.page-sub { color: var(--ink-muted); margin-top: 6px; font-size: 13px; max-width: 700px; }
.page-actions { display: flex; gap: 10px; flex-wrap: wrap; }
.btn { padding: 9px 18px; font-family: inherit; font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; transition: all 0.2s; border: 1px solid transparent; background: transparent; display: inline-flex; align-items: center; gap: 6px; }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }
.btn-primary { background: var(--ink); color: #f5f3ee; border-color: var(--ink); }
.btn-primary:hover:not(:disabled) { background: var(--accent); border-color: var(--accent); }
.btn-ghost { color: var(--ink-soft); border-color: var(--line-strong); }
.btn-ghost:hover:not(:disabled) { background: var(--bg-card); color: var(--ink); }
.btn-accent { background: var(--accent); color: #fff; border-color: var(--accent); }
.btn-accent:hover:not(:disabled) { background: #6e1832; }
.btn-sm { padding: 6px 12px; font-size: 10px; }
.btn-danger { color: var(--accent); border-color: var(--accent); }
.btn-danger:hover:not(:disabled) { background: var(--accent); color: #fff; }
.stats-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); margin-bottom: 28px; box-shadow: var(--shadow-sm); }
.stat { background: var(--bg-card); padding: 18px 22px; }
.stat-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.8px; color: var(--ink-muted); margin-bottom: 6px; }
.stat-value { font-family: var(--serif); font-size: 28px; font-weight: 600; color: var(--ink); letter-spacing: -0.5px; }
.stat-trend { font-size: 11px; color: var(--success); margin-top: 2px; font-family: var(--mono); }
.flagship-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
.flagship-card { background: var(--bg-card); border: 1px solid var(--line); padding: 22px; cursor: pointer; transition: all 0.25s cubic-bezier(0.4,0,0.2,1); position: relative; overflow: hidden; }
.flagship-card::before { content: ''; position: absolute; top: 0; left: 0; width: 3px; height: 100%; background: var(--accent); transform: scaleY(0); transform-origin: top; transition: transform 0.3s; }
.flagship-card:hover { border-color: var(--ink); transform: translateY(-2px); box-shadow: var(--shadow-md); }
.flagship-card:hover::before { transform: scaleY(1); }
.flagship-rank { font-family: var(--serif); font-size: 13px; color: var(--accent); font-weight: 700; letter-spacing: 1px; margin-bottom: 4px; }
.flagship-name { font-family: var(--serif); font-size: 20px; font-weight: 600; line-height: 1.25; margin-bottom: 10px; color: var(--ink); letter-spacing: -0.3px; }
.flagship-desc { font-size: 13px; color: var(--ink-soft); line-height: 1.5; margin-bottom: 16px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.flagship-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
.chip { display: inline-flex; align-items: center; padding: 3px 9px; background: var(--bg-elevated); border: 1px solid var(--line); font-size: 11px; color: var(--ink-soft); letter-spacing: 0.3px; font-family: var(--mono); }
.chip.accent { background: var(--accent-soft); border-color: var(--accent-soft); color: var(--accent); }
.chip.gold { background: var(--gold-soft); border-color: var(--gold-soft); color: var(--gold); }
.flagship-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 14px; border-top: 1px solid var(--line); font-size: 11px; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 1px; }
.uc-count { font-family: var(--serif); font-size: 16px; color: var(--ink); font-style: italic; text-transform: none; letter-spacing: 0; }
.detail-grid { display: grid; grid-template-columns: 340px 1fr; gap: 24px; margin-bottom: 28px; }
.info-panel { background: var(--bg-card); border: 1px solid var(--line); padding: 24px; box-shadow: var(--shadow-sm); height: fit-content; }
.panel-title { font-family: var(--serif); font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: var(--accent); margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid var(--line); font-weight: 700; }
.info-list { display: flex; flex-direction: column; gap: 14px; }
.info-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--ink-muted); margin-bottom: 3px; }
.info-value { font-size: 13px; color: var(--ink); line-height: 1.4; }
.info-value.mono { font-family: var(--mono); font-size: 12px; }
.section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; flex-wrap: wrap; gap: 12px; }
.section-title { font-family: var(--serif); font-size: 22px; font-weight: 600; letter-spacing: -0.3px; }
.section-title .count { font-style: italic; color: var(--ink-muted); font-weight: 400; margin-left: 6px; }
.uc-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
.uc-row { background: var(--bg-card); border: 1px solid var(--line); padding: 18px 22px; cursor: pointer; transition: all 0.2s; display: grid; grid-template-columns: 1fr auto auto; gap: 24px; align-items: center; }
.uc-row:hover { border-color: var(--ink); background: var(--bg-elevated); }
.uc-row-name { font-family: var(--serif); font-size: 17px; font-weight: 600; margin-bottom: 3px; }
.uc-row-desc { font-size: 12px; color: var(--ink-muted); line-height: 1.4; }
.uc-row-value { font-family: var(--serif); font-size: 18px; font-weight: 600; color: var(--accent); text-align: right; white-space: nowrap; }
.uc-row-value small { font-family: var(--mono); font-size: 10px; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 1px; display: block; font-weight: 400; }
.uc-row-status { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 1px; padding: 4px 10px; border: 1px solid var(--line-strong); }
.uc-row-status.live { background: var(--success-soft); border-color: var(--success); color: var(--success); }
.uc-row-status.pilot { background: var(--warn-soft); border-color: var(--warn); color: var(--warn); }
.uc-row-status.draft { background: var(--bg-elevated); }
.add-row { background: transparent; border: 1px dashed var(--line-strong); padding: 16px; cursor: pointer; text-align: center; color: var(--ink-muted); font-family: var(--sans); font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; width: 100%; transition: all 0.2s; }
.add-row:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
.uc-header { background: var(--bg-card); border: 1px solid var(--line); padding: 32px; margin-bottom: 24px; box-shadow: var(--shadow-sm); position: relative; overflow: hidden; }
.uc-header::after { content: ''; position: absolute; right: -40px; top: -40px; width: 200px; height: 200px; background: radial-gradient(circle, var(--accent-soft) 0%, transparent 70%); pointer-events: none; }
.uc-header-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; position: relative; z-index: 1; margin-bottom: 18px; flex-wrap: wrap; }
.uc-title { font-family: var(--serif); font-size: 30px; font-weight: 600; letter-spacing: -0.6px; line-height: 1.15; margin-bottom: 8px; }
.uc-desc { font-size: 14px; color: var(--ink-soft); line-height: 1.55; max-width: 700px; }
.uc-attrs { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 18px; position: relative; z-index: 1; padding-top: 20px; border-top: 1px solid var(--line); }
.countries-section { background: var(--bg-card); border: 1px solid var(--line); padding: 28px; box-shadow: var(--shadow-sm); }
.country-tabs { display: flex; flex-wrap: wrap; gap: 0; margin-bottom: 24px; border-bottom: 2px solid var(--line); }
.country-tab { padding: 11px 18px; font-family: var(--sans); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; border: none; background: transparent; color: var(--ink-muted); border-bottom: 2px solid transparent; margin-bottom: -2px; transition: all 0.2s; display: flex; align-items: center; gap: 8px; }
.country-tab:hover { color: var(--ink); }
.country-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
.country-tab .flag { font-size: 16px; }
.country-tab.add-tab { color: var(--ink-muted); font-style: italic; text-transform: none; letter-spacing: 0; font-size: 13px; }
.country-tab.add-tab:hover { color: var(--accent); }
.country-panel { display: none; }
.country-panel.active { display: block; animation: fadeIn 0.25s ease; }
.country-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); margin-bottom: 24px; }
.country-field { background: var(--bg-card); padding: 16px 18px; }
.country-field-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--ink-muted); margin-bottom: 6px; }
.country-field-value { font-family: var(--serif); font-size: 16px; font-weight: 600; color: var(--ink); }
.country-field-value.mono { font-family: var(--mono); font-size: 13px; font-weight: 400; }
.value-breakdown { background: var(--bg-elevated); border: 1px solid var(--line); padding: 20px; }
.value-breakdown-title { font-family: var(--serif); font-size: 12px; text-transform: uppercase; letter-spacing: 2px; color: var(--ink-soft); margin-bottom: 14px; font-weight: 700; }
.value-rows { display: flex; flex-direction: column; gap: 8px; }
.value-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px dashed var(--line); }
.value-row:last-child { border-bottom: none; padding-top: 12px; border-top: 2px solid var(--ink); font-weight: 600; }
.value-row-label { font-size: 12px; color: var(--ink-soft); }
.value-row-amount { font-family: var(--mono); font-size: 13px; color: var(--ink); }
.value-row:last-child .value-row-amount { font-family: var(--serif); font-size: 18px; color: var(--accent); font-weight: 600; }
.modal-overlay { position: fixed; inset: 0; background: rgba(13,27,42,0.5); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; z-index: 100; padding: 24px; }
.modal-overlay.active { display: flex; animation: fadeIn 0.2s; }
.modal { background: var(--bg-card); border: 1px solid var(--line); box-shadow: var(--shadow-lg); width: 100%; max-width: 720px; max-height: 90vh; overflow-y: auto; }
.modal.small { max-width: 420px; }
.modal-header { padding: 24px 28px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; background: var(--bg-elevated); }
.modal-title { font-family: var(--serif); font-size: 22px; font-weight: 600; letter-spacing: -0.3px; }
.modal-close { background: transparent; border: none; font-size: 22px; cursor: pointer; color: var(--ink-muted); padding: 4px 10px; line-height: 1; }
.modal-close:hover { color: var(--accent); }
.modal-body { padding: 28px; }
.modal-body p { color: var(--ink-soft); margin-bottom: 16px; font-size: 13px; line-height: 1.5; }
.modal-footer { padding: 18px 28px; border-top: 1px solid var(--line); display: flex; justify-content: flex-end; gap: 10px; background: var(--bg-elevated); }
.form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
.form-field { display: flex; flex-direction: column; }
.form-field.full { grid-column: 1 / -1; }
.form-field label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--ink-muted); margin-bottom: 6px; font-weight: 600; }
.form-field input, .form-field select, .form-field textarea { padding: 10px 12px; border: 1px solid var(--line-strong); background: #fff; font-family: inherit; font-size: 13px; color: var(--ink); outline: none; transition: border-color 0.15s; }
.form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: var(--accent); }
.form-field textarea { resize: vertical; min-height: 70px; font-family: inherit; }
.form-section-title { font-family: var(--serif); font-size: 13px; text-transform: uppercase; letter-spacing: 2px; color: var(--accent); margin: 18px 0 12px; padding-bottom: 8px; border-bottom: 1px solid var(--line); font-weight: 700; grid-column: 1 / -1; }
.form-section-title:first-child { margin-top: 0; }
.toast { position: fixed; bottom: 24px; right: 24px; background: var(--ink); color: #f5f3ee; padding: 14px 22px; border-left: 3px solid var(--accent); box-shadow: var(--shadow-lg); font-size: 13px; transform: translateY(100px); opacity: 0; transition: all 0.3s; z-index: 200; max-width: 380px; }
.toast.show { transform: translateY(0); opacity: 1; }
.toast.success { border-left-color: var(--success); }
.toast.error { border-left-color: var(--accent); }
.search-bar { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
.search-input { flex: 1; min-width: 200px; padding: 10px 14px; border: 1px solid var(--line-strong); background: var(--bg-card); font-family: inherit; font-size: 13px; color: var(--ink); outline: none; }
.search-input:focus { border-color: var(--accent); }
.filter-select { padding: 10px 14px; border: 1px solid var(--line-strong); background: var(--bg-card); font-family: inherit; font-size: 12px; color: var(--ink-soft); outline: none; cursor: pointer; text-transform: uppercase; letter-spacing: 0.5px; }
.banner { background: var(--warn-soft); border-left: 3px solid var(--warn); padding: 12px 18px; margin-bottom: 20px; font-size: 12px; color: var(--ink-soft); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.banner-info { background: var(--accent-soft); border-left-color: var(--accent); color: var(--ink-soft); }
.banner b { color: var(--ink); }
.password-input { width: 100%; padding: 12px 14px; border: 1px solid var(--line-strong); font-family: var(--mono); font-size: 14px; letter-spacing: 4px; text-align: center; outline: none; }
.password-input:focus { border-color: var(--accent); }
.hidden { display: none !important; }
.dimmed { opacity: 0.5; pointer-events: none; }
@media (max-width: 900px) {
  .detail-grid { grid-template-columns: 1fr; }
  .stats-bar { grid-template-columns: repeat(2, 1fr); }
  .uc-row { grid-template-columns: 1fr; }
  .uc-row-status, .uc-row-value { text-align: left; }
  main { padding: 20px 16px; }
  .page-title { font-size: 28px; }
  .topbar { padding: 12px 16px; }
}
</style>
</head>
<body>

<div class="topbar">
  <div class="brand">
    <div class="brand-mark">F</div>
    <div>
      <span class="brand-name">Flagship Registry</span>
      <span class="brand-sub">AI Use Cases · TOP 18</span>
    </div>
  </div>
  <div class="topbar-actions">
    <span class="mode-badge read" id="mode-badge">👁 Read-only</span>
    <span class="save-indicator" id="save-indicator">—</span>
    <button class="topbar-btn" onclick="openAuthModal()" id="auth-btn">🔒 Enable Edit</button>
    <button class="topbar-btn" onclick="exportJSON()">↓ Export</button>
    <button class="topbar-btn" onclick="importJSON()" id="import-btn-top" style="display:none">↑ Import</button>
    <input type="file" id="import-file" accept=".json" style="display:none" onchange="handleImport(event)">
  </div>
</div>

<nav class="breadcrumb" id="breadcrumb">
  <a onclick="showView('list')">TOP 18</a>
</nav>

<main>

<section class="view active" id="view-list">
  <div class="banner banner-info" id="welcome-banner">
    <div>
      <b>Lecture seule active.</b> Cliquez sur "Enable Edit" et entrez le mot de passe contributeur pour modifier les données. Les changements sont sauvegardés localement dans votre navigateur.
    </div>
    <button class="btn btn-sm btn-ghost" onclick="dismissBanner()">Compris</button>
  </div>

  <div class="page-header">
    <div>
      <h1 class="page-title">TOP 18 <span class="accent">Flagships</span></h1>
      <p class="page-sub">AI Use Case Registry — strategic initiatives portfolio. Données sauvegardées automatiquement.</p>
    </div>
    <div class="page-actions">
      <button class="btn btn-ghost edit-only" onclick="openFlagshipModal()" disabled>+ New flagship</button>
      <button class="btn btn-primary" onclick="exportJSON()">Export JSON</button>
    </div>
  </div>

  <div class="stats-bar">
    <div class="stat"><div class="stat-label">Flagships</div><div class="stat-value" id="stat-flagships">—</div><div class="stat-trend" id="stat-flagships-trend">portfolio</div></div>
    <div class="stat"><div class="stat-label">Total use cases</div><div class="stat-value" id="stat-usecases">—</div><div class="stat-trend">across portfolio</div></div>
    <div class="stat"><div class="stat-label">AI Value (k€)</div><div class="stat-value" id="stat-value">—</div><div class="stat-trend">FY capped</div></div>
    <div class="stat"><div class="stat-label">Countries</div><div class="stat-value" id="stat-countries">—</div><div class="stat-trend">in scope</div></div>
  </div>

  <div class="search-bar">
    <input type="text" class="search-input" id="search" placeholder="Search by name, sponsor, division…" oninput="renderList()">
    <select class="filter-select" id="filter-division" onchange="renderList()"><option value="">All divisions</option></select>
  </div>

  <div class="flagship-grid" id="flagship-grid"></div>
</section>

<section class="view" id="view-flagship">
  <div class="page-header">
    <div>
      <div class="flagship-rank" id="fd-rank"></div>
      <h1 class="page-title" id="fd-name"></h1>
      <p class="page-sub" id="fd-sub"></p>
    </div>
    <div class="page-actions">
      <button class="btn btn-ghost edit-only" onclick="editFlagship()" disabled>✎ Edit</button>
      <button class="btn btn-accent edit-only" onclick="openUseCaseModal()" disabled>+ Add use case</button>
    </div>
  </div>

  <div class="detail-grid">
    <aside class="info-panel">
      <div class="panel-title">Flagship Details</div>
      <div class="info-list" id="fd-info"></div>
    </aside>
