  fields.forEach(k => document.getElementById('muc-'+k).value = uc?.[k] || '');
  document.getElementById('muc-aiact').value = uc?.aiAct || 'Limited Risk';
  document.getElementById('muc-sourcing').value = uc?.sourcing || 'In-house';
  document.getElementById('muc-iavalue').value = uc?.iaValue || '';
  document.getElementById('muc-date-itsvc').value = uc?.dateItsvc || '';
  document.getElementById('muc-date-gate').value = uc?.dateGate || '';
  openModal('modal-usecase');
}

function editUseCase() { openUseCaseModal(state.currentUseCaseId); }

function saveUseCase() {
  const f = getFlagship(state.currentFlagshipId);
  const data = {
    name: document.getElementById('muc-name').value.trim(),
    description: document.getElementById('muc-description').value.trim(),
    pole: document.getElementById('muc-pole').value.trim(),
    entity: document.getElementById('muc-entity').value.trim(),
    aiAct: document.getElementById('muc-aiact').value,
    technology: document.getElementById('muc-technology').value.trim(),
    platform: document.getElementById('muc-platform').value.trim(),
    brick: document.getElementById('muc-brick').value.trim(),
    domain: document.getElementById('muc-domain').value.trim(),
    category: document.getElementById('muc-category').value.trim(),
    sourcing: document.getElementById('muc-sourcing').value,
    iaValue: parseFloat(document.getElementById('muc-iavalue').value) || 0,
    contributors: document.getElementById('muc-contributors').value.trim(),
    pilot: document.getElementById('muc-pilot').value.trim(),
    itsvc: document.getElementById('muc-itsvc').value.trim(),
    dateItsvc: document.getElementById('muc-date-itsvc').value,
    gate: document.getElementById('muc-gate').value.trim(),
    dateGate: document.getElementById('muc-date-gate').value
  };
  if (!data.name) { toast('Name is required', 'error'); return; }
  if (state.editingUseCaseId) {
    const uc = getUseCase(f, state.editingUseCaseId);
    Object.assign(uc, data);
    toast('Use case updated', 'success');
    persist();
    renderUseCase();
  } else {
    const newUc = { id: uid('U'), ...data, countries: [] };
    f.useCases.push(newUc);
    toast('Use case created', 'success');
    persist();
    renderFlagship();
  }
  closeModal('modal-usecase');
}

function deleteUseCase() {
  if (!confirm('Supprimer ce use case ? Cette action est irréversible.')) return;
  const f = getFlagship(state.currentFlagshipId);
  f.useCases = f.useCases.filter(u => u.id !== state.currentUseCaseId);
  toast('Use case supprimé', 'success');
  persist();
  showView('flagship', {flagshipId: f.id});
}

function openCountryModal(country) {
  if (!state.editMode) return;
  state.editingCountry = country || null;
  const f = getFlagship(state.currentFlagshipId);
  const uc = getUseCase(f, state.currentUseCaseId);
  const c = country ? uc.countries.find(x => x.country === country) : null;
  document.getElementById('mc-title').textContent = c ? `Edit ${country} Rollout` : 'Add Country Rollout';
  document.getElementById('mc-country').value = c?.country || 'France';
  document.getElementById('mc-country').disabled = !!c;
  document.getElementById('mc-year').value = c?.year || new Date().getFullYear();
  document.getElementById('mc-status').value = c?.status || 'Draft';
  document.getElementById('mc-prod').value = c?.prodDate || '';
  document.getElementById('mc-val-capped').value = c?.valCapped || '';
  document.getElementById('mc-val-nbi').value = c?.valNbi || '';
  document.getElementById('mc-val-gcs').value = c?.valGcs || '';
  document.getElementById('mc-val-ca').value = c?.valCa || '';
  document.getElementById('mc-val-cor').value = c?.valCor || '';
  document.getElementById('mc-val-rwa').value = c?.valRwa || '';
  document.getElementById('mc-measure').value = c?.measure || 'Estimated';
  document.getElementById('mc-rollout').value = c?.rollout || 'Local';
  document.getElementById('mc-mrr-cat').value = c?.mrrCat || '';
  document.getElementById('mc-mrr').value = c?.mrr || '';
  document.getElementById('mc-owner').value = c?.owner || '';
  openModal('modal-country');
}

function editCountry(country) { openCountryModal(country); }

function saveCountry() {
  const f = getFlagship(state.currentFlagshipId);
  const uc = getUseCase(f, state.currentUseCaseId);
  const data = {
    country: document.getElementById('mc-country').value,
    year: parseInt(document.getElementById('mc-year').value) || new Date().getFullYear(),
    status: document.getElementById('mc-status').value,
    prodDate: document.getElementById('mc-prod').value,
    valCapped: parseFloat(document.getElementById('mc-val-capped').value) || 0,
    valNbi: parseFloat(document.getElementById('mc-val-nbi').value) || 0,
    valGcs: parseFloat(document.getElementById('mc-val-gcs').value) || 0,
    valCa: parseFloat(document.getElementById('mc-val-ca').value) || 0,
    valCor: parseFloat(document.getElementById('mc-val-cor').value) || 0,
    valRwa: parseFloat(document.getElementById('mc-val-rwa').value) || 0,
    measure: document.getElementById('mc-measure').value,
    rollout: document.getElementById('mc-rollout').value,
    mrrCat: document.getElementById('mc-mrr-cat').value.trim(),
    mrr: document.getElementById('mc-mrr').value.trim(),
    owner: document.getElementById('mc-owner').value.trim()
  };
  if (state.editingCountry) {
    const idx = uc.countries.findIndex(c => c.country === state.editingCountry);
    uc.countries[idx] = data;
    toast(`${data.country} rollout updated`, 'success');
  } else {
    if (uc.countries.find(c => c.country === data.country)) { toast(`${data.country} existe déjà`, 'error'); return; }
    uc.countries.push(data);
    state.currentCountry = data.country;
    toast(`${data.country} rollout ajouté`, 'success');
  }
  closeModal('modal-country');
  persist();
  renderUseCase();
}

function deleteCountry(country) {
  if (!confirm(`Supprimer le déploiement pour ${country} ?`)) return;
  const f = getFlagship(state.currentFlagshipId);
  const uc = getUseCase(f, state.currentUseCaseId);
  uc.countries = uc.countries.filter(c => c.country !== country);
  if (state.currentCountry === country) state.currentCountry = uc.countries[0]?.country || null;
  toast('Pays supprimé', 'success');
  persist();
  renderUseCase();
}

// =========================================================
// JSON EXPORT / IMPORT
// =========================================================
function exportJSON() {
  const payload = {
    exportedAt: new Date().toISOString(),
    version: 1,
    flagships: state.flagships
  };
  const data = JSON.stringify(payload, null, 2);
  const blob = new Blob([data], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `flagship-top18-${new Date().toISOString().slice(0,10)}.json`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  toast('Export JSON téléchargé', 'success');
}

function importJSON() {
  if (!state.editMode) { toast('Activez d\'abord le mode édition', 'error'); return; }
  document.getElementById('import-file').click();
}

function handleImport(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const parsed = JSON.parse(e.target.result);
      let data;
      if (Array.isArray(parsed)) data = parsed; // ancien format
      else if (parsed && Array.isArray(parsed.flagships)) data = parsed.flagships;
      else throw new Error('Format invalide');
      if (!confirm(`Importer ${data.length} flagships ? Cela remplacera vos données actuelles (un export préalable est conseillé).`)) {
        event.target.value = ''; return;
      }
      state.flagships = data;
      persist();
      toast(`${data.length} flagships importés`, 'success');
      showView('list');
    } catch (err) {
      toast('Fichier JSON invalide', 'error');
      console.error(err);
    }
  };
  reader.readAsText(file);
  event.target.value = '';
}

