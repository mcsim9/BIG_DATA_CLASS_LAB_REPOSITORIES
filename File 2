// =========================================================
function renderList() {
  const total = state.flagships.length;
  let allUC = 0, allValue = 0;
  const countriesSet = new Set();
  state.flagships.forEach(f => {
    allUC += f.useCases.length;
    f.useCases.forEach(uc => {
      uc.countries.forEach(c => {
        countriesSet.add(c.country);
        allValue += (c.valCapped || 0);
      });
    });
  });
  document.getElementById('stat-flagships').textContent = total;
  document.getElementById('stat-usecases').textContent = allUC;
  document.getElementById('stat-value').textContent = fmt(allValue);
  document.getElementById('stat-countries').textContent = countriesSet.size;

  const divisions = [...new Set(state.flagships.map(f => f.division))].sort();
  const sel = document.getElementById('filter-division');
  const cur = sel.value;
  sel.innerHTML = '<option value="">All divisions</option>' + divisions.map(d => `<option value="${esc(d)}">${esc(d)}</option>`).join('');
  sel.value = cur;

  const search = document.getElementById('search').value.toLowerCase();
  const division = sel.value;

  const filtered = state.flagships.filter(f => {
    if (division && f.division !== division) return false;
    if (search) {
      const hay = `${f.name} ${f.description} ${f.sponsor} ${f.owner} ${f.division} ${f.subdivision}`.toLowerCase();
      if (!hay.includes(search)) return false;
    }
    return true;
  });

  const grid = document.getElementById('flagship-grid');
  if (filtered.length === 0) {
    grid.innerHTML = `<div style="grid-column:1/-1; padding:60px; text-align:center; color:var(--ink-muted); font-style:italic;">Aucun flagship ne correspond à votre recherche.</div>`;
    return;
  }
  grid.innerHTML = filtered.map(f => {
    const totalUcValue = f.useCases.reduce((sum, uc) => sum + uc.countries.reduce((s, c) => s + (c.valCapped || 0), 0), 0);
    return `
      <article class="flagship-card" onclick="showView('flagship', {flagshipId:'${esc(f.id)}'})">
        <div class="flagship-rank">TOP ${String(f.rank).padStart(2,'0')}</div>
        <h3 class="flagship-name">${esc(f.name)}</h3>
        <p class="flagship-desc">${esc(f.description)}</p>
        <div class="flagship-meta">
          <span class="chip accent">${esc(f.division)}</span>
          <span class="chip">${esc(f.subdivision)}</span>
        </div>
        <div class="flagship-footer">
          <span>${f.useCases.length} <span class="uc-count">use case${f.useCases.length>1?'s':''}</span></span>
          <span class="chip gold">${fmt(totalUcValue)} k€</span>
        </div>
      </article>`;
  }).join('');
}

