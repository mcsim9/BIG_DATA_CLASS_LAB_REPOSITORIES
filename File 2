function showView(view, opts) {
  opts = opts || {};
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  if (view === 'list') {
    document.getElementById('view-list').classList.add('active');
    renderList();
    setBreadcrumb([{label:'TOP 18', current:true}]);
  } else if (view === 'flagship') {
    state.currentFlagshipId = opts.flagshipId;
    document.getElementById('view-flagship').classList.add('active');
    renderFlagship();
  } else if (view === 'usecase') {
    state.currentFlagshipId = opts.flagshipId;
    state.currentUseCaseId = opts.useCaseId;
    state.currentCountry = null;
    document.getElementById('view-usecase').classList.add('active');
    renderUseCase();
  }
  applyEditMode();
  window.scrollTo({top:0, behavior:'smooth'});
}

function setBreadcrumb(items) {
  const bc = document.getElementById('breadcrumb');
  bc.innerHTML = '';
  items.forEach((it, i) => {
    if (i > 0) {
      const sep = document.createElement('span');
      sep.className = 'sep'; sep.textContent = '/';
      bc.appendChild(sep);
    }
    const el = document.createElement(it.current ? 'span' : 'a');
    el.textContent = it.label;
    if (it.current) el.className = 'current';
    if (it.action) el.onclick = it.action;
    bc.appendChild(el);
  });
}

