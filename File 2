function fmt(n) { return n == null || n === '' ? '—' : Number(n).toLocaleString('fr-FR'); }
function fmtK(n) { return n == null || n === '' ? '—' : Number(n).toLocaleString('fr-FR') + ' k€'; }
function getFlagship(id) { return state.flagships.find(f => f.id === id); }
function getUseCase(flagship, ucId) { return flagship?.useCases.find(u => u.id === ucId); }
function uid(prefix) { return prefix + '-' + Math.random().toString(36).slice(2, 8).toUpperCase(); }
function esc(s) { return String(s||'').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }

function toast(msg, type) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show' + (type ? ' ' + type : '');
  setTimeout(() => t.className = 'toast', 2800);
}

