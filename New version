/* ===================================================== */
/* 10. MODAL BUILDERS                                    */
/* ===================================================== */
function buildField(field, obj) {
  var k = field[0], lab = field[1], type = field[2], opts = field[3], full = field[4];
  if (k === '__section__') return '<div class="fr-section">' + esc(lab) + '</div>';
  var v = obj && obj[k] != null ? obj[k] : '';
  var fid = 'modal_' + k;
  var h = '<div class="fr-field' + (full ? ' full' : '') + '"><label>' + esc(lab) + '</label>';
  if (type === 'textarea') {
    h += '<textarea id="' + fid + '">' + esc(v) + '</textarea>';
  } else if (type === 'select') {
    h += '<select id="' + fid + '">';
    for (var i = 0; i < opts.length; i++) {
      h += '<option' + (opts[i] === v ? ' selected' : '') + '>' + esc(opts[i]) + '</option>';
    }
    h += '</select>';
  } else {
    h += '<input id="' + fid + '" type="' + (type || 'text') + '" value="' + esc(v) + '">';
  }
  h += '</div>';
  return h;
}

function modalShell(modalId, title, formHtml, saveFnName) {
  byId(modalId).innerHTML =
    '<div class="fr-modal">' +
      '<div class="fr-modal-head"><h2>' + esc(title) + '</h2><button type="button" class="fr-btn" onclick="App.closeModal(\'' + modalId + '\')">✕</button></div>' +
      '<div class="fr-form">' + formHtml + '</div>' +
      '<div class="fr-modal-foot">' +
        '<button type="button" class="fr-btn" onclick="App.closeModal(\'' + modalId + '\')">Cancel</button>' +
        '<button type="button" class="fr-btn primary" onclick="App.' + saveFnName + '()">Save</button>' +
      '</div>' +
    '</div>';
  byId(modalId).className = 'fr-modal-bg show';
}

function readFieldValue(field) {
  var k = field[0], type = field[2];
  if (k === '__section__') return null;
  var el = byId('modal_' + k);
  if (!el) return null;
  if (type === 'number') return Number(el.value || 0);
  return el.value;
}

function readAllFields(type, obj) {
  // Lit toutes les valeurs des champs (standard + custom) et les met dans obj
  var fields = getAllFields(type);
  for (var i = 0; i < fields.length; i++) {
    var k = fields[i][0];
    if (k === '__section__') continue;
    var v = readFieldValue(fields[i]);
    if (v !== null) obj[k] = v;
  }
}

