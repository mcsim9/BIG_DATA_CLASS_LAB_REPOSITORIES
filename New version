function renderCountries() {
  var f = findFlag(state.currentFid);
  var uc = findUc(f, state.currentUid);
  if (!uc) return;
  byId('countryCount').textContent = '(' + uc.countries.length + ')';

  if (uc.countries.length === 0) {
    byId('tabs').innerHTML = '';
    byId('countryPanel').innerHTML = '<div class="fr-empty">Aucun pays déployé. ' + (canEdit() ? 'Cliquez sur "+ Add country".' : '') + '</div>';
    return;
  }

  // Choisir le pays actif
  if (!state.currentCountry) state.currentCountry = uc.countries[0].country;
  var exists = false;
  for (var i = 0; i < uc.countries.length; i++) if (uc.countries[i].country === state.currentCountry) exists = true;
  if (!exists) state.currentCountry = uc.countries[0].country;

  // Tabs
  var tabs = '';
  for (i = 0; i < uc.countries.length; i++) {
    var c = uc.countries[i];
    var active = c.country === state.currentCountry ? 'active' : '';
    tabs += '<button type="button" class="fr-tab ' + active + '" onclick="App.selectCountry(\'' + esc(c.country) + '\')">' + esc(c.country) + '</button>';
  }
  byId('tabs').innerHTML = tabs;

  // Panel actif
  var current = null;
  for (i = 0; i < uc.countries.length; i++) if (uc.countries[i].country === state.currentCountry) current = uc.countries[i];

  var fields = getAllFields('country');
  var h = '<div class="fr-country-grid">';
  for (i = 0; i < fields.length; i++) {
    var k = fields[i][0], lab = fields[i][1];
    if (k === '__section__') continue;
    var v = current[k];
    if (k.indexOf('val') === 0) v = (v != null && v !== '') ? fmt(v) + ' k€' : '—';
    h += '<div><div class="fr-label">' + esc(lab) + '</div><div>' + esc(v || '—') + '</div></div>';
  }
  h += '</div>';
  h += '<div style="display:flex;gap:8px;margin-top:14px">';
  h += '<button type="button" class="fr-btn editOnly" onclick="App.openCountryModal(\'' + esc(current.country) + '\')" ' + (canEdit()?'':'disabled') + '>✎ Edit country</button>';
  h += '<button type="button" class="fr-btn danger editOnly" onclick="App.deleteCountry(\'' + esc(current.country) + '\')" ' + (canEdit()?'':'disabled') + '>🗑 Delete country</button>';
  h += '</div>';
  byId('countryPanel').innerHTML = h;
}

