<style>
/* ===================================================== */
/* STYLES                                                */
/* ===================================================== */
.fr-app { font-family: Arial, Helvetica, sans-serif; background: #f5f3ee; color: #0d1b2a; border: 1px solid #e3ddd0; font-size: 14px; line-height: 1.45; }
.fr-app * { box-sizing: border-box; }

/* Top bar */
.fr-topbar { background: #0d1b2a; color: #f5f3ee; padding: 14px 22px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; border-bottom: 3px solid #8b1e3f; }
.fr-mark { width: 34px; height: 34px; background: #8b1e3f; color: white; display: flex; align-items: center; justify-content: center; font-family: Georgia, serif; font-weight: bold; }
.fr-title { font-family: Georgia, serif; font-size: 20px; font-weight: bold; }
.fr-sub { font-size: 11px; opacity: .7; text-transform: uppercase; letter-spacing: 1.5px; }
.fr-actions { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

/* Buttons */
.fr-btn { border: 1px solid #c9c0ad; background: white; color: #0d1b2a; padding: 8px 12px; cursor: pointer; text-transform: uppercase; font-size: 11px; letter-spacing: .8px; font-family: inherit; }
.fr-btn:hover:not(:disabled) { border-color: #0d1b2a; }
.fr-btn.primary { background: #0d1b2a; color: white; border-color: #0d1b2a; }
.fr-btn.accent { background: #8b1e3f; color: white; border-color: #8b1e3f; }
.fr-btn.danger { color: #8b1e3f; border-color: #8b1e3f; }
.fr-btn.danger:hover:not(:disabled) { background: #8b1e3f; color: white; }
.fr-btn:disabled { opacity: .35; cursor: not-allowed; }
.fr-btn.small { padding: 5px 9px; font-size: 10px; }

/* Mode badge */
.fr-badge { padding: 4px 10px; font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; border: 1px solid; }
.fr-badge.read { background: rgba(255,255,255,.08); color: #c9c0ad; border-color: rgba(255,255,255,.2); }
.fr-badge.edit { background: #8b1e3f; color: white; border-color: #8b1e3f; }
.fr-badge.admin { background: #a07c2c; color: white; border-color: #a07c2c; }

/* Save indicator */
.fr-save { font-size: 10px; color: rgba(255,255,255,.5); font-family: monospace; }
.fr-save.saved { color: #a8d5b2; }

/* Breadcrumb */
.fr-breadcrumb { padding: 10px 22px; background: #fbfaf7; border-bottom: 1px solid #e3ddd0; font-size: 12px; color: #6b7a8c; }
.fr-breadcrumb a { cursor: pointer; color: #0d1b2a; text-decoration: none; }
.fr-breadcrumb a:hover { color: #8b1e3f; }

/* Layout */
.fr-main { padding: 22px; max-width: 1300px; margin: auto; }
.fr-page-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
h1 { font-family: Georgia, serif; font-weight: 600; margin: 0 0 5px 0; font-size: 32px; }
h2 { font-family: Georgia, serif; font-weight: 600; margin: 0; }
.fr-muted { color: #6b7a8c; }
.fr-label { font-size: 10px; color: #6b7a8c; text-transform: uppercase; letter-spacing: 1.2px; margin-bottom: 3px; }

/* Lock screen */
.fr-lock { padding: 80px 22px; text-align: center; }
.fr-lock .fr-lock-icon { font-size: 48px; margin-bottom: 18px; }
.fr-lock h1 { font-size: 28px; }
.fr-lock-form { max-width: 380px; margin: 24px auto 0; }
.fr-lock-form input { width: 100%; padding: 12px; border: 1px solid #c9c0ad; font-family: monospace; font-size: 16px; text-align: center; letter-spacing: 3px; margin-bottom: 12px; }
.fr-lock-form input:focus { outline: 1px solid #8b1e3f; border-color: #8b1e3f; }
.fr-lock-hint { font-size: 11px; color: #6b7a8c; margin-top: 14px; }

/* Banner */
.fr-banner { background: #f4e8eb; border-left: 3px solid #8b1e3f; padding: 10px 14px; margin-bottom: 16px; display: flex; justify-content: space-between; gap: 10px; align-items: center; }

/* Stats */
.fr-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: #e3ddd0; border: 1px solid #e3ddd0; margin-bottom: 18px; }
.fr-stat { background: white; padding: 14px; }
.fr-value { font-family: Georgia, serif; font-size: 25px; font-weight: bold; }

/* Search */
.fr-search { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
.fr-search input, .fr-search select { padding: 9px 12px; border: 1px solid #c9c0ad; background: white; font-family: inherit; }
.fr-search input { flex: 1; min-width: 190px; }

/* Grid + Cards */
.fr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 12px; }
.fr-card { background: white; border: 1px solid #e3ddd0; padding: 18px; cursor: pointer; transition: all 0.15s; }
.fr-card:hover { border-color: #0d1b2a; box-shadow: 0 4px 14px rgba(0,0,0,.08); transform: translateY(-2px); }
.fr-rank { font-family: Georgia, serif; color: #8b1e3f; font-weight: bold; font-size: 12px; }
.fr-name { font-family: Georgia, serif; font-size: 19px; font-weight: bold; margin: 4px 0 8px; }
.fr-chip { display: inline-block; border: 1px solid #e3ddd0; background: #fbfaf7; padding: 3px 8px; margin: 2px 2px 2px 0; font-size: 11px; }
.fr-footer { border-top: 1px solid #e3ddd0; margin-top: 12px; padding-top: 10px; display: flex; justify-content: space-between; font-size: 12px; color: #6b7a8c; }

/* Views */
.fr-view { display: none; }
.fr-view.active { display: block; }

/* Detail layout */
.fr-detail { display: grid; grid-template-columns: 320px 1fr; gap: 18px; }
.fr-panel, .fr-box { background: white; border: 1px solid #e3ddd0; padding: 18px; }
.fr-row { background: white; border: 1px solid #e3ddd0; padding: 14px; margin-bottom: 9px; cursor: pointer; display: grid; grid-template-columns: 1fr auto auto; gap: 12px; align-items: center; }
.fr-row:hover { border-color: #0d1b2a; }

/* Status pills */
.fr-status { font-size: 10px; border: 1px solid #c9c0ad; padding: 4px 8px; text-transform: uppercase; font-family: monospace; }
.fr-live { background: #e3ede5; color: #2d5a3d; border-color: #2d5a3d; }
.fr-pilot { background: #f7ecd1; color: #8a5a00; border-color: #8a5a00; }

/* Attrs grid */
.fr-attrs { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; }

/* Tabs */
.fr-tabs { border-bottom: 2px solid #e3ddd0; margin-bottom: 16px; display: flex; flex-wrap: wrap; gap: 0; }
.fr-tab { background: transparent; border: 0; border-bottom: 2px solid transparent; padding: 10px 14px; cursor: pointer; margin-bottom: -2px; font-family: inherit; font-size: 13px; }
.fr-tab.active { color: #8b1e3f; border-bottom-color: #8b1e3f; font-weight: bold; }

/* Country grid */
.fr-country-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1px; background: #e3ddd0; border: 1px solid #e3ddd0; margin-bottom: 16px; }
.fr-country-grid > div { background: white; padding: 12px; }

/* Modal */
.fr-modal-bg { display: none; position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 9999; align-items: center; justify-content: center; padding: 20px; }
.fr-modal-bg.show { display: flex; }
.fr-modal { background: white; border: 1px solid #c9c0ad; width: min(820px, 100%); max-height: 90vh; overflow: auto; }
.fr-modal-head, .fr-modal-foot { background: #fbfaf7; padding: 14px 18px; border-bottom: 1px solid #e3ddd0; display: flex; justify-content: space-between; align-items: center; gap: 10px; }
.fr-modal-foot { border-top: 1px solid #e3ddd0; border-bottom: 0; justify-content: flex-end; }

/* Forms */
.fr-form { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; padding: 18px; }
.fr-field.full { grid-column: 1 / -1; }
.fr-field label { display: block; font-size: 10px; color: #6b7a8c; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
.fr-field input, .fr-field select, .fr-field textarea { width: 100%; padding: 9px; border: 1px solid #c9c0ad; font-family: inherit; font-size: 13px; }
.fr-field textarea { min-height: 65px; resize: vertical; }
.fr-field input:focus, .fr-field select:focus, .fr-field textarea:focus { outline: 1px solid #8b1e3f; border-color: #8b1e3f; }
.fr-section { grid-column: 1 / -1; font-family: Georgia, serif; color: #8b1e3f; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid #e3ddd0; padding-bottom: 6px; margin-top: 8px; font-weight: bold; }
.fr-section:first-child { margin-top: 0; }

/* Custom fields (admin only) */
.fr-custom-field { display: flex; gap: 6px; align-items: flex-end; }
.fr-custom-field > div:first-child { flex: 1; }
.fr-custom-field .fr-btn { padding: 9px 10px; }

/* Toast */
.fr-toast { position: fixed; right: 20px; bottom: 20px; background: #0d1b2a; color: white; padding: 12px 16px; display: none; z-index: 10000; border-left: 3px solid #8b1e3f; max-width: 360px; }
.fr-toast.show { display: block; }
.fr-toast.success { border-left-color: #2d5a3d; }
.fr-toast.error { border-left-color: #8b1e3f; }

.fr-hidden { display: none !important; }
.fr-empty { padding: 30px; text-align: center; color: #6b7a8c; font-style: italic; border: 1px dashed #c9c0ad; }

@media (max-width: 800px) {
  .fr-stats { grid-template-columns: repeat(2, 1fr); }
  .fr-detail { grid-template-columns: 1fr; }
  .fr-row { grid-template-columns: 1fr; }
  .fr-form { grid-template-columns: 1fr; }
}
</style>
</head>
