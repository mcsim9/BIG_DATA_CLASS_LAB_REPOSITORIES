function manageCustomFields(type) {
  if (!canAdmin()) return;
  var typeLabel = { flagship:'Flagship', usecase:'Use Case', country:'Country' }[type];
  var custom = state.customFields[type] || [];

  var html = '<div class="fr-field full"><div class="fr-muted" style="font-size:12px;margin-bottom:10px">Champs custom existants pour <b>' + typeLabel + '</b> :</div>';
  if (custom.length === 0) {
    html += '<div class="fr-empty" style="padding:14px;font-size:12px">Aucun champ custom.</div>';
  } else {
    html += '<table style="width:100%;border-collapse:collapse;font-size:12px">';
    html += '<tr style="background:#fbfaf7"><th style="text-align:left;padding:8px;border:1px solid #e3ddd0">Key</th><th style="text-align:left;padding:8px;border:1px solid #e3ddd0">Label</th><th style="text-align:left;padding:8px;border:1px solid #e3ddd0">Type</th><th style="padding:8px;border:1px solid #e3ddd0">Action</th></tr>';
    for (var i = 0; i < custom.length; i++) {
      html += '<tr><td style="padding:8px;border:1px solid #e3ddd0;font-family:monospace">' + esc(custom[i][0]) + '</td><td style="padding:8px;border:1px solid #e3ddd0">' + esc(custom[i][1]) + '</td><td style="padding:8px;border:1px solid #e3ddd0">' + esc(custom[i][2]) + '</td><td style="padding:8px;border:1px solid #e3ddd0;text-align:center"><button type="button" class="fr-btn danger small" onclick="App.removeCustomField(\'' + type + '\',' + i + ')">🗑</button></td></tr>';
    }
    html += '</table>';
  }
  html += '</div>';

  html += '<div class="fr-section">Add new custom field</div>';
  html += '<div class="fr-field"><label>Key (technical, no spaces)</label><input id="cfKey" type="text" placeholder="ex: budget, owner2..."></div>';
  html += '<div class="fr-field"><label>Display label</label><input id="cfLabel" type="text" placeholder="ex: Budget alloué"></div>';
  html += '<div class="fr-field"><label>Type</label><select id="cfType"><option value="text">Text</option><option value="textarea">Long text</option><option value="number">Number</option><option value="date">Date</option><option value="select">Select (comma-separated options)</option></select></div>';
  html += '<div class="fr-field"><label>Options (only for select, comma-separated)</label><input id="cfOptions" type="text" placeholder="Option A, Option B, Option C"></div>';

  byId('customFieldsModal').innerHTML =
    '<div class="fr-modal">' +
      '<div class="fr-modal-head"><h2>⚙ Custom fields — ' + typeLabel + '</h2><button type="button" class="fr-btn" onclick="App.closeModal(\'customFieldsModal\')">✕</button></div>' +
      '<div class="fr-form">' + html + '</div>' +
      '<div class="fr-modal-foot">' +
        '<button type="button" class="fr-btn" onclick="App.closeModal(\'customFieldsModal\')">Close</button>' +
        '<button type="button" class="fr-btn primary" onclick="App.addCustomField(\'' + type + '\')">Add field</button>' +
      '</div>' +
    '</div>';
  byId('customFieldsModal').className = 'fr-modal-bg show';
}

function addCustomField(type) {
  var key = byId('cfKey').value.trim().replace(/[^a-zA-Z0-9_]/g, '');
  var label = byId('cfLabel').value.trim();
  var ftype = byId('cfType').value;
  var optStr = byId('cfOptions').value.trim();
  if (!key) { toast('Key requise', 'error'); return; }
  if (!label) { toast('Label requis', 'error'); return; }

  // Vérifier qu'il n'existe pas déjà
  var existing = getAllFields(type);
  for (var i = 0; i < existing.length; i++) {
    if (existing[i][0] === key) { toast('Cette key existe déjà', 'error'); return; }
  }

  var field = [key, label, ftype];
  if (ftype === 'select') {
    var opts = optStr.split(',').map(function(s) { return s.trim(); }).filter(function(s) { return s; });
    if (opts.length < 2) { toast('Au moins 2 options requises pour un select', 'error'); return; }
    field.push(opts);
  }

  state.customFields[type].push(field);
  autoSave();
  toast('Champ custom ajouté', 'success');
  manageCustomFields(type); // refresh
}

function removeCustomField(type, index) {
  if (!confirm('Supprimer ce champ custom ? Les données existantes resteront mais ne seront plus affichées.')) return;
  state.customFields[type].splice(index, 1);
  autoSave();
  toast('Champ supprimé', 'success');
  manageCustomFields(type);
}

