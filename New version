/* 9. RENDERING                                          */
/* ===================================================== */
function renderList() {
  var visibleFlagships = getVisibleData();
  var q = byId('search').value.toLowerCase();
  var div = byId('filterDiv').value;

  // Stats (calculées sur visible uniquement)
  var countries = {}, totalValue = 0, ucn = 0, divs = {};
  for (var i = 0; i < visibleFlagships.length; i++) {
    divs[visibleFlagships[i].division] = 1;
    ucn += visibleFlagships[i].useCases.length;
    for (var j = 0; j < visibleFlagships[i].useCases.length; j++) {
      var uc = visibleFlagships[i].useCases[j];
      for (var k = 0; k < uc.countries.length; k++) {
        countries[uc.countries[k].country] = 1;
        totalValue += Number(uc.countries[k].valCapped || 0);
      }
    }
  }
  byId('statF').textContent = fmt(visibleFlagships.length);
  byId('statU').textContent = fmt(ucn);
  byId('statV').textContent = fmt(totalValue);
  byId('statC').textContent = fmt(Object.keys(countries).length);

  // Division filter
  var sel = byId('filterDiv');
  var old = sel.value;
  var divHtml = '<option value="">All divisions</option>';
  var sortedDivs = Object.keys(divs).sort();
  for (i = 0; i < sortedDivs.length; i++) divHtml += '<option value="' + esc(sortedDivs[i]) + '">' + esc(sortedDivs[i]) + '</option>';
  sel.innerHTML = divHtml;
  sel.value = old;

  // Cards
  var out = '';
  for (i = 0; i < visibleFlagships.length; i++) {
    var f = visibleFlagships[i];
    var hay = (f.name + ' ' + f.description + ' ' + f.sponsor + ' ' + f.division).toLowerCase();
    if (q && hay.indexOf(q) < 0) continue;
    if (div && f.division !== div) continue;
    var tv = 0;
    for (j = 0; j < f.useCases.length; j++) tv += totalValueUc(f.useCases[j]);
    out += '<div class="fr-card" onclick="App.showFlag(\'' + esc(f.id) + '\')">' +
      '<div class="fr-rank">TOP ' + esc(String(f.rank).padStart ? String(f.rank).padStart(2,'0') : f.rank) + '</div>' +
      '<div class="fr-name">' + esc(f.name) + '</div>' +
      '<div class="fr-muted">' + esc(f.description) + '</div>' +
      '<div style="margin-top:10px"><span class="fr-chip">' + esc(f.division) + '</span><span class="fr-chip">' + esc(f.subdivision || f.sponsor) + '</span></div>' +
      '<div class="fr-footer"><span>' + f.useCases.length + ' use case' + (f.useCases.length>1?'s':'') + '</span><b>' + fmt(tv) + ' k€</b></div>' +
      '</div>';
  }
  byId('grid').innerHTML = out || '<div class="fr-empty" style="grid-column:1/-1">Aucun flagship ne correspond.</div>';
}

function renderFlag() {
  var f = findFlag(state.currentFid);
  if (!f) return;
  byId('fdRank').textContent = 'TOP ' + (String(f.rank).padStart ? String(f.rank).padStart(2,'0') : f.rank);
  byId('fdName').textContent = f.name;
