function saveFlag() {
  var f = state.editingFid ? findFlag(state.editingFid) : null;
  var isNew = !f;
  if (isNew) {
    f = { id: uid('F'), rank: state.data.length + 1, useCases: [] };
    state.data.push(f);
  }
  readAllFields('flagship', f);
  if (!f.name) { toast('Le nom est requis', 'error'); if (isNew) state.data.pop(); return; }
  autoSave();
  closeModal('flagModal');
  toast(isNew ? 'Flagship créé' : 'Flagship mis à jour', 'success');
  if (state.currentFid === f.id || isNew && state.editingFid === '') {
    if (state.currentFid) showFlag(f.id);
    else showList();
  } else {
    renderList();
  }
}

function deleteFlag() {
  if (!canEdit()) return;
  if (!confirm('Supprimer ce flagship et tous ses use cases ? Action irréversible.')) return;
  state.data = state.data.filter(function(f) { return f.id !== state.currentFid; });
  autoSave();
  toast('Flagship supprimé', 'success');
  showList();
}

