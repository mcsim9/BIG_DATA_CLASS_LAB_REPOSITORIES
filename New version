/* 15. EXPORT (JSON + Excel)                             */
/* ===================================================== */
function exportJSON() {
  var payload = {
    exportedAt: new Date().toISOString(),
    version: 3,
    customFields: state.customFields,
    flagships: state.data
  };
  var blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'flagship-registry-' + new Date().toISOString().slice(0,10) + '.json';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(a.href);
  toast('Export JSON téléchargé', 'success');
}

function exportExcel() {
  if (typeof XLSX === 'undefined') {
    toast('SheetJS non chargé. Réessayez dans un instant.', 'error');
    return;
  }

  var wb = XLSX.utils.book_new();

  // Sheet 1: Flagships
  var flagshipRows = [];
  var flagshipFields = getAllFields('flagship');
  var flagshipHeader = ['ID', 'Rank'];
  for (var i = 0; i < flagshipFields.length; i++) {
    if (flagshipFields[i][0] !== '__section__') flagshipHeader.push(flagshipFields[i][1]);
  }
  flagshipHeader.push('Use Case Count', 'Total AI Value (k€ FY)');
  flagshipRows.push(flagshipHeader);
  for (i = 0; i < state.data.length; i++) {
    var f = state.data[i];
    var row = [f.id, f.rank];
    for (var j = 0; j < flagshipFields.length; j++) {
      if (flagshipFields[j][0] !== '__section__') row.push(f[flagshipFields[j][0]] || '');
    }
    var totalVal = 0;
    for (var k = 0; k < f.useCases.length; k++) totalVal += totalValueUc(f.useCases[k]);
    row.push(f.useCases.length, totalVal);
    flagshipRows.push(row);
  }
  XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(flagshipRows), 'Flagships');

  // Sheet 2: Use Cases
  var ucFields = getAllFields('usecase');
  var ucRows = [];
  var ucHeader = ['Flagship ID', 'Flagship Name', 'Use Case ID'];
  for (i = 0; i < ucFields.length; i++) if (ucFields[i][0] !== '__section__') ucHeader.push(ucFields[i][1]);
  ucRows.push(ucHeader);
  for (i = 0; i < state.data.length; i++) {
    var ff = state.data[i];
    for (j = 0; j < ff.useCases.length; j++) {
      var uc = ff.useCases[j];
      var urow = [ff.id, ff.name, uc.id];
      for (k = 0; k < ucFields.length; k++) {
        if (ucFields[k][0] !== '__section__') urow.push(uc[ucFields[k][0]] || '');
      }
      ucRows.push(urow);
    }
  }
  XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(ucRows), 'Use Cases');

  // Sheet 3: Country Rollouts
  var ctFields = getAllFields('country');
  var ctRows = [];
  var ctHeader = ['Flagship ID', 'Flagship Name', 'Use Case ID', 'Use Case Name'];
  for (i = 0; i < ctFields.length; i++) if (ctFields[i][0] !== '__section__') ctHeader.push(ctFields[i][1]);
  ctRows.push(ctHeader);
  for (i = 0; i < state.data.length; i++) {
    var fff = state.data[i];
    for (j = 0; j < fff.useCases.length; j++) {
      var ucc = fff.useCases[j];
      for (k = 0; k < ucc.countries.length; k++) {
        var c = ucc.countries[k];
        var crow = [fff.id, fff.name, ucc.id, ucc.name];
        for (var l = 0; l < ctFields.length; l++) {
          if (ctFields[l][0] !== '__section__') crow.push(c[ctFields[l][0]] != null ? c[ctFields[l][0]] : '');
        }
        ctRows.push(crow);
      }
    }
  }
  XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(ctRows), 'Country Rollouts');

  XLSX.writeFile(wb, 'flagship-registry-' + new Date().toISOString().slice(0,10) + '.xlsx');
  toast('Export Excel téléchargé', 'success');
}

/* ===================================================== */
/* 16. IMPORT JSON                                       */
/* ===================================================== */
function handleImport(event) {
  var file = event.target.files[0];
  if (!file) return;
  var r = new FileReader();
  r.onload = function(ev) {
    try {
      var parsed = JSON.parse(ev.target.result);
      var newData;
      if (Array.isArray(parsed)) {
        newData = parsed;
      } else if (parsed && Array.isArray(parsed.flagships)) {
        newData = parsed.flagships;
        if (parsed.customFields) state.customFields = parsed.customFields;
      } else {
        throw new Error('bad format');
      }
      if (!confirm('Importer ' + newData.length + ' flagships ? Vos données actuelles seront remplacées.')) {
        event.target.value = ''; return;
      }
      state.data = newData;
      autoSave();
      toast(newData.length + ' flagships importés', 'success');
      showList();
    } catch(x) {
      toast('Fichier JSON invalide', 'error');
    }
  };
  r.readAsText(file);
  event.target.value = '';
}

/* ===================================================== */
/* 17. INIT                                              */
/* ===================================================== */
function init() {
  loadStorage();
  loadSession();

  // File input
  byId('importFile').onchange = handleImport;

  showSaveIndicator('init');
  applyAccessLevel();

  if (state.accessLevel === 'locked') {
    showOnly('viewLock');
  } else {
    showList();
  }
}

/* ===================================================== */
/* 18. PUBLIC API                                        */
/* ===================================================== */
return {
  state: state,
  // Auth
  openAuth: openAuth,
  tryAuth: tryAuth,
  tryAuthLock: tryAuthLock,
  lockApp: lockApp,
  // Navigation
  showList: showList,
  showFlag: showFlag,
  showUc: showUc,
  selectCountry: selectCountry,
  // Rendering
  renderList: renderList,
  // CRUD Flagship
  openFlagModal: openFlagModal,
  saveFlag: saveFlag,
  deleteFlag: deleteFlag,
  // CRUD Use Case
  openUcModal: openUcModal,
  saveUc: saveUc,
  deleteUc: deleteUc,
  // CRUD Country
  openCountryModal: openCountryModal,
  saveCountry: saveCountry,
  deleteCountry: deleteCountry,
  // Custom fields
  manageCustomFields: manageCustomFields,
  addCustomField: addCustomField,
  removeCustomField: removeCustomField,
  // Export
  exportJSON: exportJSON,
  exportExcel: exportExcel,
  // UI
  closeModal: closeModal,
  hideBanner: hideBanner,
  // Init
  init: init
};

})();

// Bootstrap
App.init();
</script>
