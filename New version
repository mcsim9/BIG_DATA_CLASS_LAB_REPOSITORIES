          <div id="ucList" style="margin-top:14px"></div>
        </div>
      </div>
    </section>

    <!-- =============== USE CASE DETAIL VIEW =============== -->
    <section id="viewUc" class="fr-view">
      <div class="fr-box">
        <div class="fr-page-head">
          <div>
