/* ===================================================== */
var state = {
  data: null,                // tableau des flagships (avec leurs use cases et pays)
  customFields: {            // champs custom ajoutés par l'admin
    flagship: [],            // ex: [['budget','Budget','number']]
    usecase: [],
    country: []
  },
  accessLevel: 'locked',     // 'locked' | 'viewer' | 'contrib' | 'admin'
  currentFid: null,
  currentUid: null,
  currentCountry: null,
  editingFid: '',
  editingUid: '',
  editingCountry: ''
};

/* ===================================================== */
/* 4. PERSISTANCE (localStorage)                         */
/* ===================================================== */
function loadStorage() {
  try {
    var raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      var parsed = JSON.parse(raw);
      state.data = parsed.data || clone(DEFAULT_DATA);
      state.customFields = parsed.customFields || { flagship:[], usecase:[], country:[] };
      return;
    }
  } catch(e) {}
  state.data = clone(DEFAULT_DATA);
}

function saveStorage() {
  try {
    var payload = { data: state.data, customFields: state.customFields, savedAt: new Date().toISOString() };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
    showSaveIndicator(true);
    return true;
  } catch(e) {
    showSaveIndicator(false);
    return false;
  }
}

// Debounce save pour auto-save
var saveTimer = null;
function autoSave() {
  showSaveIndicator('saving');
  clearTimeout(saveTimer);
  saveTimer = setTimeout(saveStorage, 300);
}

function showSaveIndicator(status) {
  var el = byId('saveIndicator');
  if (!el) return;
  if (status === 'saving') {
    el.textContent = '⟳ Saving…';
    el.className = 'fr-save';
  } else if (status === true) {
    var now = new Date();
    el.textContent = '✓ Saved ' + now.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
    el.className = 'fr-save saved';
  } else if (status === false) {
    el.textContent = '⚠ Save failed';
    el.className = 'fr-save';
  } else if (status === 'init') {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        var p = JSON.parse(raw);
        if (p.savedAt) {
          var d = new Date(p.savedAt);
          el.textContent = '✓ Saved ' + d.toLocaleDateString('fr-FR') + ' ' + d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
          el.className = 'fr-save saved';
          return;
        }
      }
    } catch(e) {}
    el.textContent = '—';
  }
}

// Session: mémoriser le niveau d'accès le temps de la session (sessionStorage)
function loadSession() {
  try {
    var lvl = sessionStorage.getItem(SESSION_KEY);
    if (lvl && (lvl === 'viewer' || lvl === 'contrib' || lvl === 'admin')) {
      state.accessLevel = lvl;
    }
  } catch(e) {}
}

function saveSession() {
  try {
    if (state.accessLevel === 'locked') sessionStorage.removeItem(SESSION_KEY);
    else sessionStorage.setItem(SESSION_KEY, state.accessLevel);
  } catch(e) {}
}

/* ===================================================== */
/* 5. HELPERS                                            */
/* ===================================================== */
function byId(id) { return document.getElementById(id); }
function esc(s) {
  s = String(s == null ? '' : s);
  return s.replace(/[&<>"']/g, function(m) {
    return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[m];
  });
}
function fmt(n) { if (n == null || n === '') return '—'; return Number(n).toLocaleString('fr-FR'); }
function clone(o) { return JSON.parse(JSON.stringify(o)); }
function findFlag(id) {
  for (var i = 0; i < state.data.length; i++) if (state.data[i].id === id) return state.data[i];
  return null;
}
function findUc(f, id) {
  if (!f) return null;
  for (var i = 0; i < f.useCases.length; i++) if (f.useCases[i].id === id) return f.useCases[i];
  return null;
}
function uid(p) { return p + '-' + Math.random().toString(36).slice(2, 8).toUpperCase(); }

function totalValueUc(uc) {
  var s = 0;
  for (var i = 0; i < uc.countries.length; i++) s += Number(uc.countries[i].valCapped || 0);
  return s;
}

function statusClass(uc) {
  var pilot = false;
  for (var i = 0; i < uc.countries.length; i++) {
    if (uc.countries[i].status === 'Industrialized') return 'fr-live';
    if (uc.countries[i].status === 'Pilot') pilot = true;
  }
  return pilot ? 'fr-pilot' : '';
}

function getAllFields(type) {
  // Retourne les champs standard + custom pour un type donné
  var baseFields;
  if (type === 'flagship') baseFields = FLAGSHIP_FIELDS;
  else if (type === 'usecase') baseFields = USECASE_FIELDS;
  else if (type === 'country') baseFields = COUNTRY_FIELDS;
  else return [];
  return baseFields.concat(state.customFields[type] || []);
}

function isVisible(flagshipId) {
  // Détermine si un flagship est visible selon le niveau d'accès
  if (state.accessLevel === 'locked') return false;
  var allowed = VISIBLE_FLAGSHIPS[state.accessLevel];
  if (allowed === '*') return true;
  if (Array.isArray(allowed)) return allowed.indexOf(flagshipId) !== -1;
  return true;
}

function getVisibleData() {
  // Retourne la liste filtrée selon le niveau d'accès
  var out = [];
  for (var i = 0; i < state.data.length; i++) {
    if (isVisible(state.data[i].id)) out.push(state.data[i]);
  }
  return out;
}

function canEdit() {
  return state.accessLevel === 'contrib' || state.accessLevel === 'admin';
}
function canAdmin() {
  return state.accessLevel === 'admin';
}

/* ===================================================== */
/* 6. UI HELPERS                                         */
/* ===================================================== */
function toast(msg, type) {
  var t = byId('toast');
  t.textContent = msg;
  t.className = 'fr-toast show' + (type ? ' ' + type : '');
  setTimeout(function() { t.className = 'fr-toast'; }, 2400);
}

function showOnly(id) {
  var views = document.querySelectorAll('.fr-view');
  for (var i = 0; i < views.length; i++) views[i].className = 'fr-view';
  byId(id).className = 'fr-view active';
}

function setBreadcrumb(html) { byId('breadcrumb').innerHTML = html; }

function applyAccessLevel() {
  // Met à jour le badge + visibilité des boutons selon le niveau
  var badge = byId('modeBadge');
  var bc = byId('breadcrumb');

  if (state.accessLevel === 'locked') {
    badge.textContent = '🔒 Locked';
    badge.className = 'fr-badge read';
    bc.className = 'fr-breadcrumb fr-hidden';
  } else if (state.accessLevel === 'viewer') {
    badge.textContent = '👁 Viewer';
    badge.className = 'fr-badge read';
    bc.className = 'fr-breadcrumb';
  } else if (state.accessLevel === 'contrib') {
    badge.textContent = '✎ Contributor';
    badge.className = 'fr-badge edit';
    bc.className = 'fr-breadcrumb';
  } else if (state.accessLevel === 'admin') {
    badge.textContent = '★ Admin';
    badge.className = 'fr-badge admin';
    bc.className = 'fr-breadcrumb';
  }

  // Visibilité des boutons
  var unlockedEls = document.querySelectorAll('.unlockedOnly');
  for (var i = 0; i < unlockedEls.length; i++) {
    unlockedEls[i].className = unlockedEls[i].className.replace(/fr-hidden/g, '').trim();
    if (state.accessLevel === 'locked') unlockedEls[i].className += ' fr-hidden';
  }

  var editEls = document.querySelectorAll('.editOnly');
  for (i = 0; i < editEls.length; i++) editEls[i].disabled = !canEdit();

  var adminEls = document.querySelectorAll('.adminOnly');
  for (i = 0; i < adminEls.length; i++) adminEls[i].disabled = !canAdmin();

  // Import JSON : seulement édition
  var importBtn = byId('importBtn');
  if (importBtn) {
    importBtn.className = canEdit() ? 'fr-btn editOnly' : 'fr-btn editOnly fr-hidden';
  }
}

/* ===================================================== */
/* 7. AUTH                                               */
/* ===================================================== */
function tryAuthLock() {
  var pw = byId('lockPw').value;
  var level = PASSWORDS[pw];
  if (level) {
    state.accessLevel = level;
    saveSession();
    byId('lockPw').value = '';
    applyAccessLevel();
    showList();
    toast('✓ Accès accordé : ' + level, 'success');
  } else {
    byId('lockPw').value = '';
    toast('Mot de passe incorrect', 'error');
  }
}

function openAuth() {
  if (state.accessLevel === 'locked') {
    showOnly('viewLock');
    setTimeout(function() { byId('lockPw').focus(); }, 50);
    return;
  }
  byId('authPw').value = '';
  byId('authModal').className = 'fr-modal-bg show';
  setTimeout(function() { byId('authPw').focus(); }, 50);
}

function tryAuth() {
  var pw = byId('authPw').value;
  var level = PASSWORDS[pw];
  if (level) {
    state.accessLevel = level;
    saveSession();
    byId('authPw').value = '';
    closeModal('authModal');
    applyAccessLevel();
    showList();
    toast('✓ Niveau d\'accès changé : ' + level, 'success');
  } else {
    byId('authPw').value = '';
    toast('Mot de passe incorrect', 'error');
  }
}

