    var k = fields[i][0], lab = fields[i][1];
    if (k === '__section__') continue;
    if (k === 'name' || k === 'description') continue; // déjà affichés en titre
    info += '<div style="margin-bottom:12px"><div class="fr-label">' + esc(lab) + '</div><div>' + esc(f[k] || '—') + '</div></div>';
  }
