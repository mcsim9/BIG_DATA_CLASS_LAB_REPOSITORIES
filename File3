let storageWorks = true;
try { const t = '__fr_test_' + Date.now(); localStorage.setItem(t, '1'); localStorage.removeItem(t); }
catch(e) { storageWorks = false; console.warn('localStorage indisponible'); }
let memStore = {};
function sGet(k) { if (!storageWorks) return memStore[k] || null; try { return localStorage.getItem(k); } catch(e) { return null; } }
function sSet(k, v) { if (!storageWorks) { memStore[k] = v; return true; } try { localStorage.setItem(k, v); return true; } catch(e) { frToast('⚠ Sauvegarde échouée', 'error'); return false; } }

function loadData() {
  const raw = sGet(STORAGE_KEY);
  if (!raw) return JSON.parse(JSON.stringify(DEFAULT_DATA));
  try {
    const p = JSON.parse(raw);
    if (!Array.isArray(p)) throw new Error();
    return p;
  } catch(e) { return JSON.parse(JSON.stringify(DEFAULT_DATA)); }
}

let saveTimer = null;
function persist() {
  clearTimeout(saveTimer);
  setSaveInd('saving');
  saveTimer = setTimeout(() => {
    const ok = sSet(STORAGE_KEY, JSON.stringify(state.flagships));
    sSet(STORAGE_META_KEY, JSON.stringify({ lastSaved: new Date().toISOString() }));
    setSaveInd(ok ? 'saved' : 'error');
  }, AUTO_SAVE_DEBOUNCE);
}

function setSaveInd(s) {
  const el = document.getElementById('fr-save-ind');
  if (!el) return;
  if (s === 'saving') { el.textContent = '⟳ Saving…'; el.className = 'fr-save-ind'; }
  else if (s === 'saved') {
    const d = new Date();
    el.textContent = '✓ Saved ' + d.toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'});
    el.className = 'fr-save-ind saved';
  } else if (s === 'error') { el.textContent = '⚠ Save failed'; el.className = 'fr-save-ind'; }
  else if (s === 'init') {
    const meta = sGet(STORAGE_META_KEY);
    if (meta) {
      try {
        const m = JSON.parse(meta);
        const d = new Date(m.lastSaved);
        el.textContent = '✓ Saved ' + d.toLocaleDateString('fr-FR') + ' ' + d.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
        el.className = 'fr-save-ind saved';
      } catch(e) { el.textContent = '—'; }
    } else el.textContent = '—';
  }
}

