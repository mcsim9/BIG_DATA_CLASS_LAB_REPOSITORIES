function showView(view, opts) {
  opts = opts || {};
  document.querySelectorAll('.fr-view').forEach(v => v.classList.remove('active'));
  if (view === 'list') {
    document.getElementById('fr-view-list').classList.add('active');
    renderList();
    setBreadcrumb([{label:'TOP 18', current:true}]);
  } else if (view === 'flagship') {
    state.currentFlagshipId = opts.flagshipId;
    document.getElementById('fr-view-flagship').classList.add('active');
    renderFlagship();
  } else if (view === 'usecase') {
    state.currentFlagshipId = opts.flagshipId;
    state.currentUseCaseId = opts.useCaseId;
    state.currentCountry = null;
    document.getElementById('fr-view-usecase').classList.add('active');
    renderUseCase();
  }
  applyEditMode();
  window.scrollTo({top:0, behavior:'smooth'});
}
window.frShowView = showView;

function setBreadcrumb(items) {
  const bc = document.getElementById('fr-breadcrumb');
  bc.innerHTML = '';
  items.forEach((it, i) => {
    if (i > 0) { const s = document.createElement('span'); s.className = 'sep'; s.textContent = '/'; bc.appendChild(s); }
    const el = document.createElement(it.current ? 'span' : 'a');
    el.textContent = it.label;
    if (it.current) el.className = 'current';
    if (it.action) el.onclick = it.action;
    bc.appendChild(el);
  });
}

// =========================================================
// RENDER: LIST
// =========================================================
function renderList() {
  let allUC = 0, allValue = 0;
  const countries = new Set();
  state.flagships.forEach(f => {
    allUC += f.useCases.length;
    f.useCases.forEach(uc => {
      uc.countries.forEach(c => { countries.add(c.country); allValue += (c.valCapped || 0); });
    });
  });
  document.getElementById('fr-stat-f').textContent = state.flagships.length;
  document.getElementById('fr-stat-u').textContent = allUC;
  document.getElementById('fr-stat-v').textContent = fmt(allValue);
  document.getElementById('fr-stat-c').textContent = countries.size;

  const divisions = [...new Set(state.flagships.map(f => f.division))].sort();
  const sel = document.getElementById('fr-filter-div');
  const cur = sel.value;
  sel.innerHTML = '<option value="">All divisions</option>' + divisions.map(d => '<option value="' + esc(d) + '">' + esc(d) + '</option>').join('');
  sel.value = cur;

  const search = document.getElementById('fr-search').value.toLowerCase();
  const division = sel.value;

  const filtered = state.flagships.filter(f => {
    if (division && f.division !== division) return false;
    if (search) {
      const hay = (f.name + ' ' + f.description + ' ' + f.sponsor + ' ' + f.owner + ' ' + f.division + ' ' + f.subdivision).toLowerCase();
      if (!hay.includes(search)) return false;
    }
    return true;
  });

  const grid = document.getElementById('fr-grid');
  if (filtered.length === 0) {
    grid.innerHTML = '<div style="grid-column:1/-1;padding:60px;text-align:center;color:var(--ink-muted);font-style:italic;">Aucun flagship ne correspond à votre recherche.</div>';
    return;
  }
  grid.innerHTML = filtered.map(f => {
    const tv = f.useCases.reduce((s, uc) => s + uc.countries.reduce((ss, c) => ss + (c.valCapped || 0), 0), 0);
    return '<article class="fr-card" data-fid="' + esc(f.id) + '">' +
      '<div class="fr-rank">TOP ' + String(f.rank).padStart(2,'0') + '</div>' +
      '<h3 class="fr-name">' + esc(f.name) + '</h3>' +
      '<p class="fr-desc">' + esc(f.description) + '</p>' +
      '<div class="fr-meta"><span class="fr-chip fr-chip-accent">' + esc(f.division) + '</span><span class="fr-chip">' + esc(f.subdivision) + '</span></div>' +
      '<div class="fr-card-footer"><span>' + f.useCases.length + ' <span class="fr-uc-num">use case' + (f.useCases.length > 1 ? 's' : '') + '</span></span><span class="fr-chip fr-chip-gold">' + fmt(tv) + ' k€</span></div>' +
    '</article>';
  }).join('');

  // Bind clicks
  grid.querySelectorAll('.fr-card').forEach(c => {
    c.addEventListener('click', () => showView('flagship', {flagshipId: c.dataset.fid}));
  });
}

document.getElementById('fr-search').addEventListener('input', renderList);
document.getElementById('fr-filter-div').addEventListener('change', renderList);

