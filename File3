function renderUseCase() {
  const f = getF(state.currentFlagshipId);
  const uc = getU(f, state.currentUseCaseId);
  if (!uc) return showView('flagship', {flagshipId: state.currentFlagshipId});

  document.getElementById('fr-uc-name').textContent = uc.name;
  document.getElementById('fr-uc-desc').textContent = uc.description;

  const attrs = [
    ['Pole', uc.pole], ['Entity', uc.entity], ['AI Act Category', uc.aiAct],
    ['Technology', uc.technology], ['Platform', uc.platform], ['Main AI Brick', uc.brick],
    ['AI Domain', uc.domain], ['AI Category', uc.category], ['Sourcing', uc.sourcing],
    ['IA Value Total', fmtK(uc.iaValue)], ['Pilot Country', uc.pilot],
    ['Model contributors', uc.contributors], ['ITSVC 2', uc.itsvc], ['Date ITSVC', uc.dateItsvc],
    ['Last gate passed', uc.gate], ['Date Last gate', uc.dateGate]
  ];
  document.getElementById('fr-uc-attrs').innerHTML = attrs.map(([l,v]) =>
    '<div><div class="fr-info-label">' + l + '</div><div class="fr-info-value">' + (esc(v) || '—') + '</div></div>'
  ).join('');

  document.getElementById('fr-uc-cc').textContent = '(' + uc.countries.length + ')';
  const tabs = document.getElementById('fr-ctabs');
  const panels = document.getElementById('fr-cpanels');

  if (uc.countries.length === 0) {
    tabs.innerHTML = '<div style="padding:18px;color:var(--ink-muted);font-style:italic;">Aucun pays déployé. ' + (state.editMode ? 'Cliquez sur "Add country" pour en ajouter.' : 'Activez le mode édition pour ajouter un pays.') + '</div>';
    panels.innerHTML = '';
  } else {
    if (!state.currentCountry || !uc.countries.find(c => c.country === state.currentCountry)) {
      state.currentCountry = uc.countries[0].country;
    }
    tabs.innerHTML = uc.countries.map(c =>
      '<button class="fr-ctab ' + (c.country === state.currentCountry ? 'active' : '') + '" data-c="' + esc(c.country) + '"><span class="flag">' + (FLAGS[c.country] || '🏳️') + '</span> ' + esc(c.country) + '</button>'
    ).join('') + (state.editMode ? '<button class="fr-ctab fr-ctab-add" id="fr-ctab-add">+ Add country</button>' : '');

    panels.innerHTML = uc.countries.map(c =>
      '<div class="fr-cpanel ' + (c.country === state.currentCountry ? 'active' : '') + '" data-c="' + esc(c.country) + '">' + renderCountryPanel(c) + '</div>'
    ).join('');

    tabs.querySelectorAll('.fr-ctab[data-c]').forEach(t => {
      t.addEventListener('click', () => selectCountry(t.dataset.c));
    });
    const addTab = document.getElementById('fr-ctab-add');
    if (addTab) addTab.addEventListener('click', frOpenCountryModal);

    // bind edit/delete on panel buttons
    panels.querySelectorAll('[data-action="edit-country"]').forEach(b => {
      b.addEventListener('click', () => frEditCountry(b.dataset.c));
    });
    panels.querySelectorAll('[data-action="delete-country"]').forEach(b => {
      b.addEventListener('click', () => frDeleteCountry(b.dataset.c));
    });
  }

  setBreadcrumb([
    {label:'TOP 18', action:() => showView('list')},
    {label:f.name, action:() => showView('flagship', {flagshipId:f.id})},
    {label:uc.name, current:true}
  ]);
}

