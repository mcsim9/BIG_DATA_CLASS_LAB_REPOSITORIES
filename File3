function fmt(n) { return n == null || n === '' ? '—' : Number(n).toLocaleString('fr-FR'); }
function fmtK(n) { return n == null || n === '' ? '—' : Number(n).toLocaleString('fr-FR') + ' k€'; }
function getF(id) { return state.flagships.find(f => f.id === id); }
function getU(f, id) { return f && f.useCases.find(u => u.id === id); }
function uid(p) { return p + '-' + Math.random().toString(36).slice(2, 8).toUpperCase(); }
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }

function frToast(msg, type) {
  const t = document.getElementById('fr-toast');
