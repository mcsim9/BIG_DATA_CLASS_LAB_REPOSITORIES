}
window.frOpenUseCaseModal = frOpenUseCaseModal;
window.frEditUseCase = () => frOpenUseCaseModal(state.currentUseCaseId);

window.frSaveUseCase = function() {
  const f = getF(state.currentFlagshipId);
  const d = {};
  ['name','description','pole','entity','technology','platform','brick','domain','category','contributors','pilot','itsvc','gate'].forEach(k => {
