function tryAuth() {
  const pw = document.getElementById('fr-auth-pw').value;
  if (pw === EDIT_PASSWORD) {
    state.editMode = true;
    applyEditMode();
    bootstrap.Modal.getInstance(document.getElementById('frModalAuth')).hide();
    frToast('🔓 Mode édition activé', 'success');
    document.getElementById('fr-auth-pw').value = '';
  } else {
    frToast('Mot de passe incorrect', 'error');
    document.getElementById('fr-auth-pw').value = '';
  }
}

function applyEditMode() {
  const badge = document.getElementById('fr-mode-badge');
  const authBtn = document.getElementById('fr-auth-btn');
  const importBtn = document.getElementById('fr-import-btn');
  if (state.editMode) {
    badge.textContent = '✎ Editing';
    badge.className = 'fr-badge fr-badge-edit';
    authBtn.textContent = '🔓 Lock';
    authBtn.removeAttribute('data-bs-toggle');
    authBtn.removeAttribute('data-bs-target');
    importBtn.classList.remove('fr-hidden');
  } else {
    badge.textContent = '👁 Read-only';
    badge.className = 'fr-badge fr-badge-read';
    authBtn.textContent = '🔒 Enable Edit';
    authBtn.setAttribute('data-bs-toggle', 'modal');
    authBtn.setAttribute('data-bs-target', '#frModalAuth');
    importBtn.classList.add('fr-hidden');
  }
  document.querySelectorAll('.fr-edit-only').forEach(el => {
    el.disabled = !state.editMode;
    el.classList.toggle('fr-dimmed', !state.editMode);
  });
}

