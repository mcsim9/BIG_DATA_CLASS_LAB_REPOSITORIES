function renderFlagship() {
  const f = getF(state.currentFlagshipId);
  if (!f) return showView('list');
  document.getElementById('fr-fd-rank').textContent = 'TOP ' + String(f.rank).padStart(2,'0');
  document.getElementById('fr-fd-name').textContent = f.name;
  document.getElementById('fr-fd-sub').textContent = f.description;

  document.getElementById('fr-fd-info').innerHTML = [
    ['Sponsor', f.sponsor], ['AI Use Case Owner', f.owner], ['Division', f.division], ['Sub Division', f.subdivision],
    ['Point of Contact', f.poc], ['AI Business Analyst', f.analyst]
  ].map(([l,v]) => '<div><div class="fr-info-label">' + l + '</div><div class="fr-info-value">' + esc(v) + '</div></div>').join('') +
    '<div><div class="fr-info-label">Flagship ID</div><div class="fr-info-value mono">' + esc(f.id) + '</div></div>';

  document.getElementById('fr-fd-uc-count').textContent = '(' + f.useCases.length + ')';
  const list = document.getElementById('fr-fd-uc-list');
  if (f.useCases.length === 0) {
    list.innerHTML = '<div style="padding:28px;text-align:center;color:var(--ink-muted);font-style:italic;border:1px dashed var(--line-strong);">Aucun use case pour ce flagship.</div>';
  } else {
    list.innerHTML = f.useCases.map(uc => {
      const tv = uc.countries.reduce((s, c) => s + (c.valCapped || 0), 0);
      const liveCount = uc.countries.filter(c => c.status === 'Industrialized').length;
      const cls = liveCount > 0 ? 'live' : (uc.countries.some(c => c.status === 'Pilot') ? 'pilot' : 'draft');
      const txt = liveCount > 0 ? liveCount + ' live' : (uc.countries.length > 0 ? 'Pilot' : 'Draft');
      return '<div class="fr-uc-row" data-fid="' + esc(f.id) + '" data-uid="' + esc(uc.id) + '">' +
        '<div><div class="fr-uc-rname">' + esc(uc.name) + '</div><div class="fr-uc-rdesc">' + esc(uc.description) + '</div></div>' +
        '<div class="fr-status fr-status-' + cls + '">' + txt + ' · ' + uc.countries.length + ' pays</div>' +
        '<div class="fr-uc-rval">' + fmt(tv) + ' <small>k€ FY capped</small></div>' +
      '</div>';
    }).join('');
    list.querySelectorAll('.fr-uc-row').forEach(r => {
      r.addEventListener('click', () => showView('usecase', {flagshipId: r.dataset.fid, useCaseId: r.dataset.uid}));
    });
  }

  setBreadcrumb([
    {label:'TOP 18', action:() => showView('list')},
    {label:f.name, current:true}
  ]);
}

