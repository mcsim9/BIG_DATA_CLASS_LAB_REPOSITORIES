    persist();
    renderUseCase();
  } else {
    f.useCases.push(Object.assign({id: uid('U'), countries: []}, d));
    frToast('Use case créé', 'success');
    persist();
    renderFlagship();
  }
  bsModal('frModalUseCase').hide();
};

window.frDeleteUseCase = function() {
  if (!confirm('Supprimer ce use case ? Action irréversible.')) return;
  const f = getF(state.currentFlagshipId);
  f.useCases = f.useCases.filter(u => u.id !== state.currentUseCaseId);
