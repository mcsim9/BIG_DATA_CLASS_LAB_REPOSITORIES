    document.getElementById('fr-mf-' + k).value = f ? (f[k] || '') : '';
  });
  bsModal('frModalFlagship').show();
}
window.frOpenFlagshipModal = frOpenFlagshipModal;
window.frEditFlagship = () => frOpenFlagshipModal(state.currentFlagshipId);

window.frSaveFlagship = function() {
  const d = {};
  ['name','description','sponsor','owner','division','subdivision','poc','analyst'].forEach(k => {
    d[k] = document.getElementById('fr-mf-' + k).value.trim();
  });
  if (!d.name) { frToast('Le nom est requis', 'error'); return; }
  if (state.editingFlagshipId) {
    Object.assign(getF(state.editingFlagshipId), d);
    frToast('Flagship modifié', 'success');
  } else {
    state.flagships.push(Object.assign({id: uid('F'), rank: state.flagships.length + 1, useCases: []}, d));
    frToast('Flagship créé', 'success');
  }
  bsModal('frModalFlagship').hide();
  persist();
  if (state.editingFlagshipId === state.currentFlagshipId && document.getElementById('fr-view-flagship').classList.contains('active')) renderFlagship();
  else renderList();
};

