// =========================================================
// COUNTRY CRUD
// =========================================================
function frOpenCountryModal(country) {
  if (!state.editMode) return;
  state.editingCountry = country || null;
  const f = getF(state.currentFlagshipId);
  const uc = getU(f, state.currentUseCaseId);
  const c = country ? uc.countries.find(x => x.country === country) : null;
  document.getElementById('fr-mc-title').textContent = c ? ('Edit ' + country + ' Rollout') : 'Add Country Rollout';
  document.getElementById('fr-mc-country').value = c ? c.country : 'France';
  document.getElementById('fr-mc-country').disabled = !!c;
  document.getElementById('fr-mc-year').value = c ? c.year : new Date().getFullYear();
  document.getElementById('fr-mc-status').value = c ? c.status : 'Draft';
  document.getElementById('fr-mc-prod').value = c ? (c.prodDate || '') : '';
  ['val-capped','val-nbi','val-gcs','val-ca','val-cor','val-rwa'].forEach(k => {
    const key = 'val' + k.split('-')[1].charAt(0).toUpperCase() + k.split('-')[1].slice(1);
    document.getElementById('fr-mc-' + k).value = c ? (c[key] || '') : '';
  });
  document.getElementById('fr-mc-measure').value = c ? c.measure : 'Estimated';
  document.getElementById('fr-mc-rollout').value = c ? c.rollout : 'Local';
  document.getElementById('fr-mc-mrr-cat').value = c ? (c.mrrCat || '') : '';
  document.getElementById('fr-mc-mrr').value = c ? (c.mrr || '') : '';
  document.getElementById('fr-mc-owner').value = c ? (c.owner || '') : '';
  bsModal('frModalCountry').show();
}
window.frOpenCountryModal = frOpenCountryModal;
window.frEditCountry = country => frOpenCountryModal(country);

window.frSaveCountry = function() {
  const f = getF(state.currentFlagshipId);
  const uc = getU(f, state.currentUseCaseId);
  const d = {
    country: document.getElementById('fr-mc-country').value,
    year: parseInt(document.getElementById('fr-mc-year').value) || new Date().getFullYear(),
    status: document.getElementById('fr-mc-status').value,
    prodDate: document.getElementById('fr-mc-prod').value,
    valCapped: parseFloat(document.getElementById('fr-mc-val-capped').value) || 0,
    valNbi: parseFloat(document.getElementById('fr-mc-val-nbi').value) || 0,
    valGcs: parseFloat(document.getElementById('fr-mc-val-gcs').value) || 0,
    valCa: parseFloat(document.getElementById('fr-mc-val-ca').value) || 0,
    valCor: parseFloat(document.getElementById('fr-mc-val-cor').value) || 0,
    valRwa: parseFloat(document.getElementById('fr-mc-val-rwa').value) || 0,
    measure: document.getElementById('fr-mc-measure').value,
    rollout: document.getElementById('fr-mc-rollout').value,
    mrrCat: document.getElementById('fr-mc-mrr-cat').value.trim(),
    mrr: document.getElementById('fr-mc-mrr').value.trim(),
    owner: document.getElementById('fr-mc-owner').value.trim()
  };
  if (state.editingCountry) {
    const idx = uc.countries.findIndex(c => c.country === state.editingCountry);
    uc.countries[idx] = d;
    frToast(d.country + ' rollout modifié', 'success');
  } else {
    if (uc.countries.find(c => c.country === d.country)) { frToast(d.country + ' existe déjà', 'error'); return; }
    uc.countries.push(d);
    state.currentCountry = d.country;
    frToast(d.country + ' rollout ajouté', 'success');
  }
  bsModal('frModalCountry').hide();
  persist();
  renderUseCase();
};

window.frDeleteCountry = function(country) {
  if (!confirm('Supprimer le déploiement ' + country + ' ?')) return;
  const f = getF(state.currentFlagshipId);
  const uc = getU(f, state.currentUseCaseId);
  uc.countries = uc.countries.filter(c => c.country !== country);
  if (state.currentCountry === country) state.currentCountry = uc.countries[0] ? uc.countries[0].country : null;
  frToast('Pays supprimé', 'success');
  persist();
  renderUseCase();
};

// =========================================================
// JSON EXPORT/IMPORT
// =========================================================
window.frExportJSON = function() {
  const payload = { exportedAt: new Date().toISOString(), version: 1, flagships: state.flagships };
  const blob = new Blob([JSON.stringify(payload, null, 2)], {type: 'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'flagship-top18-' + new Date().toISOString().slice(0,10) + '.json';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  frToast('Export JSON téléchargé', 'success');
};

document.getElementById('fr-import-file').addEventListener('change', function(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    try {
      const p = JSON.parse(ev.target.result);
      const data = Array.isArray(p) ? p : (p && Array.isArray(p.flagships) ? p.flagships : null);
      if (!data) throw new Error('format');
      if (!confirm('Importer ' + data.length + ' flagships ? Vos données actuelles seront remplacées (faites un export avant si besoin).')) {
        e.target.value = '';
        return;
      }
      state.flagships = data;
      persist();
      frToast(data.length + ' flagships importés', 'success');
      showView('list');
    } catch(err) { frToast('Fichier JSON invalide', 'error'); console.error(err); }
  };
  reader.readAsText(file);
  e.target.value = '';
});

